# The quality gate (SPEC 8.7). `make check` runs what CI runs, in order.

TOOL      := go tool -modfile=tools/go.mod
PLATFORMS := darwin/amd64 darwin/arm64 linux/amd64 linux/arm64 windows/amd64 windows/arm64

.PHONY: check check-os check-static deps update fmt tidy vet staticcheck lint test vulncheck cross build release release-check release-snapshot fixtures-sync fixtures-check

check: fmt tidy vet staticcheck lint test vulncheck cross

# CI splits check in two: what can differ by operating system runs on all
# three, the static analysis and cross-builds once.
check-os: fmt tidy vet test
check-static: staticcheck lint vulncheck cross

# Updates dependencies, test ones included, to their latest minor and
# patch versions, and the pinned tools to their latest releases (with the
# dependency versions those releases chose), then runs every check.
update:
	go get -u -t ./...
	go mod tidy
	cd tools && go get tool && go mod tidy
	$(MAKE) check

# Lists the dependencies (and pinned tools) that have newer versions.
deps:
	go list -m -u -f '{{if .Update}}{{.Path}} {{.Version}} -> {{.Update.Version}}{{end}}' all
	cd tools && go list -m -u -f '{{if .Update}}{{.Path}} {{.Version}} -> {{.Update.Version}}{{end}}' all | grep -E 'golangci-lint|honnef.co/go/tools|golang.org/x/vuln|goreleaser' || true

fmt:
	@out="$$(gofmt -l .)"; if [ -n "$$out" ]; then echo "gofmt needed:"; echo "$$out"; exit 1; fi

tidy:
	go mod tidy -diff
	cd tools && go mod tidy -diff

vet:
	go vet ./...

staticcheck:
	$(TOOL) staticcheck ./...

lint:
	$(TOOL) golangci-lint run

test:
	go test -race ./...

vulncheck:
	$(TOOL) govulncheck ./...

cross:
	@for p in $(PLATFORMS); do \
		echo "go build $$p"; \
		GOOS=$${p%/*} GOARCH=$${p#*/} go build -o /dev/null ./... || exit 1; \
	done

build:
	go build -o bin/trk ./cmd/trk

# Cuts a release: make release bumps the patch version of the last tag
# (0.4.0 -> 0.4.1); BUMP=minor or BUMP=major for bigger steps, or V=1.2.3.
# Renames CHANGELOG.md's "## Unreleased" to the version, commits, tags
# and pushes; CI publishes.
BUMP ?= patch
LAST := $(shell git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null | sed 's/^v//')
NEXT := $(shell echo "$(or $(LAST),0.0.0)" | awk -F. -v b="$(BUMP)" '{ \
	if (b == "major") print $$1+1 ".0.0"; \
	else if (b == "minor") print $$1 "." $$2+1 ".0"; \
	else print $$1 "." $$2 "." $$3+1 }')
V ?= $(NEXT)

release:
	@echo "$(V)" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$$' || { echo "bad version $(V): use BUMP=major|minor|patch or V=1.2.3"; exit 1; }
	@test "$$(git branch --show-current)" = master || { echo "not on master"; exit 1; }
	@test -z "$$(git status --porcelain --untracked-files=no)" || { echo "commit or stash your changes first"; exit 1; }
	@! git rev-parse -q --verify "refs/tags/v$(V)" >/dev/null || { echo "v$(V) already exists"; exit 1; }
	@grep -q '^## Unreleased$$' CHANGELOG.md || { echo "CHANGELOG.md has no '## Unreleased' section"; exit 1; }
	@echo "Releasing v$(V) (last: v$(or $(LAST),none))"
	sed -i.bak 's/^## Unreleased$$/## $(V)/' CHANGELOG.md && rm CHANGELOG.md.bak
	git commit -qm "Release v$(V)" CHANGELOG.md
	git tag "v$(V)"
	git push -q origin master "v$(V)"
	@echo "Pushed v$(V); CI publishes it: gh run watch"

# Releases are made by CI from a tag; these check them locally.
release-check:
	HOMEBREW_TAP_TOKEN=unused $(TOOL) goreleaser check

release-snapshot:
	HOMEBREW_TAP_TOKEN=unused $(TOOL) goreleaser release --snapshot --clean --skip=publish

# The API fixtures are generated by trk from its real controllers
# (test/cli_fixtures in the trk repository). device.code.fast is ours.
TRK_DIR  ?= ../trk
FIXTURES := internal/api/apitest/testdata/fixtures

fixtures-sync:
	cp $(TRK_DIR)/test/cli_fixtures/*.json $(FIXTURES)/

fixtures-check:
	@for f in $(TRK_DIR)/test/cli_fixtures/*.json; do \
		cmp -s "$$f" "$(FIXTURES)/$${f##*/}" || { echo "$${f##*/} differs from trk's; run make fixtures-sync"; exit 1; }; \
	done
	@echo "fixtures match trk's"
