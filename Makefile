# The quality gate (SPEC 8.7). `make check` runs what CI runs, in order.

TOOL      := go tool -modfile=tools/go.mod
PLATFORMS := darwin/amd64 darwin/arm64 linux/amd64 linux/arm64 windows/amd64 windows/arm64

.PHONY: check fmt tidy vet staticcheck lint test vulncheck cross build release-check release-snapshot fixtures-sync fixtures-check

check: fmt tidy vet staticcheck lint test vulncheck cross

fmt:
	@out="$$(gofmt -l .)"; if [ -n "$$out" ]; then echo "gofmt needed:"; echo "$$out"; exit 1; fi

tidy:
	go mod tidy -diff
	cd tools && go mod tidy -diff

vet:
	go vet ./...

staticcheck:
	$(TOOL) staticcheck ./...

lint:
	$(TOOL) golangci-lint run

test:
	go test -race ./...

vulncheck:
	$(TOOL) govulncheck ./...

cross:
	@for p in $(PLATFORMS); do \
		echo "go build $$p"; \
		GOOS=$${p%/*} GOARCH=$${p#*/} go build -o /dev/null ./... || exit 1; \
	done

build:
	go build -o bin/trk ./cmd/trk

# Releases are made by CI from a tag; these check them locally.
release-check:
	HOMEBREW_TAP_TOKEN=unused $(TOOL) goreleaser check

release-snapshot:
	HOMEBREW_TAP_TOKEN=unused $(TOOL) goreleaser release --snapshot --clean --skip=publish

# The API fixtures are generated by trk from its real controllers
# (test/cli_fixtures in the trk repository). device.code.fast is ours.
TRK_DIR  ?= ../trk
FIXTURES := internal/api/apitest/testdata/fixtures

fixtures-sync:
	cp $(TRK_DIR)/test/cli_fixtures/*.json $(FIXTURES)/

fixtures-check:
	@for f in $(TRK_DIR)/test/cli_fixtures/*.json; do \
		cmp -s "$$f" "$(FIXTURES)/$${f##*/}" || { echo "$${f##*/} differs from trk's; run make fixtures-sync"; exit 1; }; \
	done
	@echo "fixtures match trk's"
