# Signing in shows the approval page, waits, stores the token where no
# one can see it, and says who you are.
fake-trk device.code.fast device.token.pending device.token.ok me.ok
exits 0 trk login
stderr 'Open this page to approve:'
stderr '  http://trk.test/cli/approve\?code=WDJB-MJHT'
stderr 'WDJB-MJHT'
stderr 'session is kept in .*credentials.json'
stdout '^Signed in as Franco Catena \(Hullop\)\.$'
! stdout test_access_token
! stderr test_access_token
grep 'http://trk.test/cli/approve\?code=WDJB-MJHT' $WORK/browser.log

# The session is used from then on.
exits 0 trk whoami
stdout 'Franco Catena'
stdout 'Hullop'
! stderr 'session is kept'

# --no-browser never opens one.
rm $WORK/browser.log
exits 0 trk login --no-browser
! exists $WORK/browser.log

# Under --json, one document on stdout and nothing else there.
exits 0 trk login --no-browser --json
stdout '"user"'
stdout '"organization"'
stderr 'Open this page'
! stdout 'Open this page'

# Extra arguments are wrong usage.
exits 2 trk login extra
stderr 'trk: '
