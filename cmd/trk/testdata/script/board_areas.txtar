# One area per command: added, or replacing the one of that name.
env TRK_TOKEN=test_access_token
fake-trk boards.list.ok board.update.areas
exits 0 trk board edit Support --area Security --covers 'Access and leaks' --people ana@example.com
stdout '^Updated TyzgACHc57CG: Product › Support$'

exits 2 trk board edit Support --covers 'x'
stderr '--covers and --people need --area'
exits 2 trk board edit Support --remove-area Billing
stderr 'Support has no area "Billing"'
