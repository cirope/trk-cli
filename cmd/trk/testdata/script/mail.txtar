# Held mail: list it, file a thread as a card, or discard it.
env TRK_TOKEN=test_access_token
fake-trk mail.list.ok
exits 0 trk mail
cmp stdout mail.txt
exits 0 trk mail --json
stdout '"reason": "no_board"'

fake-trk mail.file.ok
exits 0 trk mail file Mx7tHrEad2Qx --board Support
stdout '^Filed as CaRdFrMaiL3x in Product › Support · To do$'
exits 0 trk mail file Mx7tHrEad2Qx --board Support -q
stdout '^CaRdFrMaiL3x$'

fake-trk mail.discard.ok
exits 0 trk mail discard Mx7tHrEad2Qx --block
stdout '^Discarded Mx7tHrEad2Qx and blocked bob@shop.example\.$'

# Mistakes caught before asking.
exits 2 trk mail file Mx7tHrEad2Qx
stderr 'needs --board'
exits 2 trk mail discard
stderr 'needs one thread'
exits 2 trk mail frobnicate
stderr 'unknown command "frobnicate" for trk mail'
exits 2 trk mail discard ../../x
stderr 'not a trk id'

-- mail.txt --
Mx7tHrEad2Qx  Invoice 12 is frozen
  from Bob Shop <bob@shop.example> · no board for it · Nov 13
  Why can't we edit invoice 12 any more?
