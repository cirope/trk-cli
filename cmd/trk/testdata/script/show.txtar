# A card as a person reads it, by id or by URL.
env TRK_TOKEN=test_access_token
fake-trk card.get.ok card.markdown.ok
exits 0 trk card show BaHtsbhzVDa9
cmp stdout card.txt
! stderr .
exits 0 trk card show 'https://trk.hullop.com/boards/TyzgACHc57CG/cards/BaHtsbhzVDa9?tab=files'
cmp stdout card.txt

# --json is the card, with null for what is absent.
exits 0 trk card show BaHtsbhzVDa9 --json
stdout '"id": "BaHtsbhzVDa9"'
stdout '"pull_request": null'
stdout '"notes": "Has the new_export flag on."'

# --markdown is the server's document, untouched.
exits 0 trk card show BaHtsbhzVDa9 --markdown
cmp stdout card.md

# --web opens the card's page.
exits 0 trk card show BaHtsbhzVDa9 --web
grep 'http://trk.test/boards/TyzgACHc57CG/cards/BaHtsbhzVDa9' $WORK/browser.log

# Not found, or not yours: exit 3.
fake-trk card.get.not_found
exits 3 trk card show BaHtsbhzVDa9
stderr 'trk: getting card BaHtsbhzVDa9: Not found.'
exits 3 trk card show BaHtsbhzVDa9 --json
stderr '"code":"not_found"'

# Not a card: wrong usage, and the server is never asked.
exits 2 trk card show ../../me
stderr 'not a card id'
exits 2 trk card show
stderr 'needs one card'
exits 2 trk card show BaHtsbhzVDa9 --web --markdown
stderr 'either --web or --markdown'

